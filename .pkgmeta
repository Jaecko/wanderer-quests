# BigWigs packager: the zip is the addon folder "WandererQuests", the changelog of the
# version is CHANGELOG.md (written at each release from the full changelog).
package-as: WandererQuests

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Quests needs Wanderer, and pairs with Wanderer Auction (the shopping list).
required-dependencies:
  - wanderer
optional-dependencies:
  - wanderer-auction
